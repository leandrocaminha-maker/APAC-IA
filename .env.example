# ──────────────────────────────────────────────
# Evolution API (WhatsApp)
# ──────────────────────────────────────────────
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=sua-chave-evolution
EVOLUTION_INSTANCE=apacademia

# URL pública pela qual a Evolution é acessada (usada por ela para montar
# links de QR code e mídia). Em produção, o domínio/IP da VPS.
EVOLUTION_SERVER_URL=http://localhost:8080

# ──────────────────────────────────────────────
# Anthropic — Claude (cérebro do agente)
# Gere em console.anthropic.com → API Keys
# ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ──────────────────────────────────────────────
# Supabase — projeto DEDICADO a este sistema (não é o do AQUAP).
# É nele que a migration supabase/migrations/001_whatsapp_schema.sql roda.
# A chave precisa ser a service_role (o backend depende de ignorar o RLS).
# ──────────────────────────────────────────────
SUPABASE_URL=https://aheoopiymromrnanhvoe.supabase.co
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-service-role-key

# ──────────────────────────────────────────────
# EVO / W12 (Sistema de Gestão da Academia)
# ──────────────────────────────────────────────
EVO_API_DNS=APACADEMIA
EVO_API_TOKEN=cole-aqui-o-token-evo

# ──────────────────────────────────────────────
# Servidor
# ──────────────────────────────────────────────
PORT=3100

# Secret do webhook da Evolution API.
# Se preenchido, toda requisição em /webhook/evolution DEVE apresentá-lo
# no header x-webhook-secret (ou ?secret=). Configure o mesmo valor na
# Evolution — veja o passo a passo no README.
WEBHOOK_SECRET=apac-webhook-secret-2026

# ──────────────────────────────────────────────
# Rotas /admin
# Dá acesso a histórico de conversas, telefones de clientes e ao QR code
# de pareamento do WhatsApp. Gere um valor aleatório e NÃO reaproveite
# as chaves dos apps. Sem esta variável, /admin fica bloqueado (503).
#   node -e "console.log(crypto.randomUUID())"
# ──────────────────────────────────────────────
ADMIN_API_KEY=gere-uma-chave-uuid-aqui

# ──────────────────────────────────────────────
# Página de teste — http://SEU_IP:3100/teste
# Sandbox web para o time conversar com a Leia sem WhatsApp. Autenticação
# por senha única, sem usuário. Tudo o que for conversado ali fica gravado
# no canal 'web-test', separado do atendimento real.
#
# A página fica exposta por IP e cada resposta gasta crédito de API: troque
# a senha padrão e desligue a página quando a rodada de testes terminar.
#   TESTE_SESSION_SECRET: sem ele as sessões caem a cada restart
# ──────────────────────────────────────────────
TESTE_HABILITADO=true
TESTE_SENHA=Leia
TESTE_SESSION_SECRET=gere-uma-chave-uuid-aqui
TESTE_MAX_MSGS_SESSAO=80
TESTE_MAX_MSGS_DIA=800

# ──────────────────────────────────────────────
# Painel CRM — https://crm.apacademia.com.br
#
# Login por consultor (tabela crm_users), não senha única: o painel escreve
# venda em produção no EVO, e sem autor a tabela do funil não sabe dizer
# quem agendou nem quem vendeu.
#
# Crie o primeiro administrador com:
#   node scripts/criar-consultor.js --nome "Fulano" --email f@ap.com --admin
#
#   CRM_SESSION_SECRET: sem ele as sessões caem a cada restart
# ──────────────────────────────────────────────
CRM_HABILITADO=true
CRM_SESSION_SECRET=gere-uma-chave-aleatoria-longa-aqui
CRM_SESSAO_HORAS=12
CRM_URL_PUBLICA=https://crm.apacademia.com.br

# Assina a resposta enviada pelo painel com o primeiro nome do consultor
# ("*Shirlei:*" + quebra de linha), que e o mesmo formato que o aparelho ja
# usa. false envia sem assinatura.
CRM_ASSINAR_RESPOSTA=true

# ──────────────────────────────────────────────
# Webhooks do EVO → este serviço
#
# Registrados em Ajustes → Webhooks do EVO, no painel. O EVO manda o valor
# abaixo no header X-Evo-Secret; sem ele /webhook/evo responde 503 e o
# funil não recebe venda nem conversão.
# ──────────────────────────────────────────────
EVO_WEBHOOK_SECRET=gere-uma-chave-aleatoria-longa-aqui

# ──────────────────────────────────────────────
# EVO — filial, origem e guarda de ensaio
#
# EVO_DRY_RUN=true faz cadastro de prospect, agendamento e venda NÃO saírem
# para o EVO: são só registrados no log e o funil anda igual. Use para
# ensaiar o fluxo do painel sem sujar o sistema de produção da academia.
# Leitura continua real nos dois modos.
# ──────────────────────────────────────────────
EVO_ID_BRANCH=1
EVO_CANAL_MARKETING=WHATSAPP / LEIA
EVO_DRY_RUN=false

# Meses sem contrato para um ex-aluno voltar a ser lead (e poder fazer aula
# experimental). O EVO nunca devolve `member` para `prospect` sozinho — quem
# aplica a regra é a Leia. Abaixo deste prazo, o caso é de retenção.
EVO_MESES_REATIVACAO=3

# Intervalo (min) do worker que reconcilia o funil com o EVO. Cobre o que o
# webhook do EVO não emite: mudança de etapa e conversão feitas lá dentro.
# 0 desliga.
EVO_SYNC_MINUTOS=15

# Intervalo (min) do worker de follow-up de venda: lembrete da aula
# experimental, conversa depois da aula e as duas rodadas de sondagem.
# Todo envio respeita a janela de contato ativo (9h–20h30). 0 desliga.
#
# Este ciclo lê uma FILA indexada e NÃO custa token nenhum — só Postgres. O
# que os 10 minutos compram é pontualidade: o lembrete de 24h e a reconsulta
# de presença saem com o atraso de até um ciclo. Subir para 60 economiza
# quase nada e atrasa os dois.
FOLLOWUP_MINUTOS=10

# ──────────────────────────────────────────────
# Follow-up — lead que parou de responder
#
# Régua separada das sondagens, que só valem para quem fez aula
# experimental. Esta pega quem sumiu em qualquer outro ponto: no meio da
# conversa, depois de ouvir o preço, depois de um consultor prometer
# retorno.
#
# O relógio é a NOSSA última fala sem resposta — da Leia ou do consultor.
# Dois dias dela e sai a 1ª cutucada; como ela vira a nossa última fala,
# mais dois dias de silêncio e sai a 2ª, no 4º dia. Depois disso, nada:
# duas rodadas e o lead é encerrado como perdido.
#
# Mensagem de cobrança e de campanha (`app:*`) NÃO contam como nossa fala:
# quem não respondeu a um boleto não é lead em silêncio.
# ──────────────────────────────────────────────

FOLLOWUP_SILENCIO_HABILITADO=true

# Intervalo (min) da varredura. Separado de FOLLOWUP_MINUTOS porque isto é
# um scan dos leads da semana, não a leitura de uma fila — e silêncio de
# dois dias não muda de minuto em minuto. 0 desliga.
FOLLOWUP_SILENCIO_MINUTOS=60

# Dias de silêncio para a 1ª cutucada. A 2ª sai 2 dias depois dela.
FOLLOWUP_SILENCIO_DIAS=2

# Quão para trás a varredura enxerga. É o teto que impede a primeira
# execução de acordar lead de meses atrás, para quem uma retomada não é
# retomada, é abordagem fria. 7 = "os leads desta semana".
#
# Para alcançar o acumulado além disso, use o painel:
#   POST /crm/api/followups/varredura  { "janelaDias": 30 }
# Ele SIMULA por padrão — só grava com "simular": false.
FOLLOWUP_SILENCIO_JANELA_DIAS=7

# Teto de agendamentos por varredura. Segura o susto do primeiro ciclo
# depois do deploy, quando a semana inteira está elegível de uma vez.
FOLLOWUP_SILENCIO_LOTE=15

# Espaçamento (min) entre os agendamentos de uma mesma varredura. 15
# mensagens no mesmo minuto é o que denuncia robô — e satura a instância.
FOLLOWUP_SILENCIO_INTERVALO_MIN=7

# ──────────────────────────────────────────────
# Agente — agrupamento de mensagens picotadas
#
# No WhatsApp a pergunta chega em pedaços: "oi", "quero saber de natação",
# "pro meu filho". Sem agrupar, cada pedaço dispara um turno completo do
# agente — o triplo do custo, e a primeira resposta saindo antes de a pessoa
# terminar de perguntar.
#
#   AGENTE_DEBOUNCE_SEGUNDOS: quanto esperar por mais um balão depois do
#     último. 0 desliga o agrupamento e volta a responder na hora.
#   AGENTE_DEBOUNCE_TETO_SEGUNDOS: teto de espera contado do PRIMEIRO balão.
#     Sem ele, quem digita sem parar nunca é respondido.
# ──────────────────────────────────────────────
AGENTE_DEBOUNCE_SEGUNDOS=12
AGENTE_DEBOUNCE_TETO_SEGUNDOS=45

# ──────────────────────────────────────────────
# Transcricao de audio recebido no WhatsApp
#
# O Claude NAO aceita audio, entao isto exige um servico de fora — nao e
# escolha de custo, e a unica via. Groq foi escolhido por velocidade: 30s de
# audio em 1 a 2 segundos, o que cabe dentro da conversa.
#
# Rodar local (whisper.cpp) foi medido e descartado nesta VPS: 20 a 40s por
# audio e ~350 MB de RAM disputando com o container que atende cliente.
#
# SEM a chave, a transcricao fica desligada e o audio recebe a resposta de
# sempre, pedindo texto. Nada quebra.
#
# Chave gratuita em console.groq.com
# ──────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODELO_AUDIO=whisper-large-v3-turbo
TRANSCRICAO_MAX_MB=8
TRANSCRICAO_TIMEOUT_MS=25000

# ──────────────────────────────────────────────
# Campanha ativa de vendas
#
# Aqui a academia é quem começa a conversa, com gente da base do EVO que
# nunca falou com a Leia. Disparo ativo por WhatsApp não-oficial é o padrão
# que mais gera bloqueio de número — e o número é um só, o principal.
#
# Por isso os dois interruptores nascem no modo seguro: subir o código não
# liga campanha nenhuma. Ligar é decisão de alguém, registrada aqui.
#
#   CAMPANHA_HABILITADA: false = o worker nem inicia.
#   CAMPANHA_DRY_RUN:    true  = gera e grava os textos, NÃO envia nada.
#                        Leia o que sairia com "npm run campanha -- status <slug>"
#                        ANTES de virar para false.
#   CAMPANHA_MINUTOS:    intervalo do worker que agenda os disparos. 0 desliga.
#   CAMPANHA_CARENCIA_DIAS: quantos dias alguém que RECEBEU e NÃO RESPONDEU
#                        fica fora das campanhas seguintes. 0 desliga.
#
#                        Não é supressão. Quem pede para sair vai para
#                        `crm_supressoes` e não volta. Carência é o silêncio,
#                        que quer dizer "agora não" e não "nunca" — insistir
#                        na semana seguinte é o que transforma oferta em
#                        incômodo, e é o caminho mais curto para o número ser
#                        denunciado.
#
# O teto diário e o limiar de pausa automática são POR CAMPANHA, no banco.
# ──────────────────────────────────────────────
CAMPANHA_HABILITADA=false
CAMPANHA_DRY_RUN=true
CAMPANHA_MINUTOS=10
CAMPANHA_CARENCIA_DIAS=30

# ──────────────────────────────────────────────
# Apps irmãos — chaves de acesso à API interna
# Cada app recebe uma chave para chamar POST /api/send
# ──────────────────────────────────────────────
APP_API_KEY_AQUAP=gere-uma-chave-uuid-aqui
APP_API_KEY_PAGTOS=gere-uma-chave-uuid-aqui
APP_API_KEY_NFSE=gere-uma-chave-uuid-aqui
